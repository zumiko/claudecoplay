#!/bin/sh
# Start Claude Code inside tmux, so coplay has a pane to split into.
#
# The plugin's games need a tmux pane, and a Claude session that is already
# running outside tmux cannot be moved into one. This is the one-command way in:
# it starts (or reattaches to) a tmux session and runs Claude inside it.
#
#   coplay              start a fresh Claude session inside tmux
#   coplay --continue   pick up your most recent conversation instead
#   coplay -- <args>    pass anything else straight through to claude
#
# Install it on your PATH if you like:
#   ln -s ~/.claude/skills/coplay/bin/coplay /usr/local/bin/coplay

set -u

SESSION=coplay

# tmux is a system package, so coplay cannot just bundle it. What it can do is
# work out the right command and offer to run it. Strictly opt-in: it asks
# first, it only asks when there is a terminal to answer on, and it never runs
# a package manager from the /snake path -- only from this script, which you
# ran deliberately.
if ! command -v tmux >/dev/null 2>&1; then
  echo "coplay needs tmux to open a game pane, and it is not installed."
  echo ""

  INSTALL=""
  if command -v brew >/dev/null 2>&1; then
    INSTALL="brew install tmux"
  elif command -v apt-get >/dev/null 2>&1; then
    INSTALL="sudo apt-get install -y tmux"
  elif command -v dnf >/dev/null 2>&1; then
    INSTALL="sudo dnf install -y tmux"
  elif command -v pacman >/dev/null 2>&1; then
    INSTALL="sudo pacman -S --noconfirm tmux"
  elif command -v apk >/dev/null 2>&1; then
    INSTALL="sudo apk add tmux"
  fi

  if [ -z "$INSTALL" ]; then
    echo "No package manager I recognise. Install tmux however you normally"
    echo "would, then run coplay again."
    exit 1
  fi

  # No terminal to read an answer from (piped, CI, etc): print, do not run.
  if [ ! -t 0 ]; then
    echo "Install it with:  $INSTALL"
    exit 1
  fi

  printf 'Run "%s" now? [y/N] ' "$INSTALL"
  read -r reply
  case "$reply" in
    y | Y | yes | YES | Yes)
      echo ""
      if ! sh -c "$INSTALL"; then
        echo ""
        echo "That did not complete. Install tmux yourself and run coplay again."
        exit 1
      fi
      ;;
    *)
      echo "Left alone. Install tmux with:  $INSTALL"
      exit 1
      ;;
  esac

  if ! command -v tmux >/dev/null 2>&1; then
    echo "tmux still is not on PATH. Open a new shell and try coplay again."
    exit 1
  fi
  echo ""
  echo "tmux is ready."
fi
if ! command -v claude >/dev/null 2>&1; then
  echo "coplay could not find 'claude' on your PATH."
  echo "Install Claude Code first: https://claude.com/claude-code"
  exit 1
fi

if [ -n "${TMUX:-}" ]; then
  echo "You are already inside tmux - just type /snake, /tetris or /asteroids."
  exit 0
fi

# Reattach rather than nesting a second session on top of an existing one.
if tmux has-session -t "$SESSION" 2>/dev/null; then
  echo "Reattaching to the existing '$SESSION' tmux session..."
  exec tmux attach-session -t "$SESSION"
fi

# Strip a leading -- so `coplay -- --model opus` works as you would expect.
if [ "${1:-}" = "--" ]; then shift; fi

quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
CMD="claude"
for arg in "$@"; do CMD="$CMD $(quote "$arg")"; done

echo "Starting Claude inside tmux (session: $SESSION)."
echo "Type /snake, /tetris or /asteroids once it is up."
exec tmux new-session -s "$SESSION" "$CMD"
